---
// Newsletter capture. Submissions are emailed to the site owner via FormSubmit
// (free, no signup — the first submission triggers a one-time confirmation email
// to the address below, then it works automatically). Swap for Mailchimp/Brevo later.
const OWNER_EMAIL = 'maksgallo@gmail.com';
const FORM_ACTION = `https://formsubmit.co/${OWNER_EMAIL}`;
---
<section class="wrap" style="padding-top:56px;padding-bottom:64px">
  <div style="background:var(--coral-tint);border:1px solid oklch(0.90 0.04 45);border-radius:24px;padding:44px;text-align:center">
    <h2 style="font-weight:700;font-size:30px;letter-spacing:-0.02em;text-wrap:balance">Planning a Riviera trip? Get our best tips.</h2>
    <p style="color:var(--soft);font-size:15.5px;margin-top:8px;max-width:480px;margin-left:auto;margin-right:auto">One short email a month — new guides, seasonal events and hotel deals worth booking. No spam.</p>
    <form action={FORM_ACTION} method="post" style="margin-top:22px;display:flex;gap:10px;max-width:440px;margin-left:auto;margin-right:auto">
      <input type="hidden" name="_subject" value="New French Riviera Tips newsletter signup" />
      <input type="hidden" name="_captcha" value="false" />
      <input type="hidden" name="_template" value="table" />
      <input type="email" name="email" required placeholder="you@email.com" style="flex:1;border:1px solid oklch(0.88 0.03 45);border-radius:11px;padding:14px 16px;font-size:15px;outline:none;background:#fff" />
      <button type="submit" class="btn-coral">Subscribe</button>
    </form>
  </div>
</section>
