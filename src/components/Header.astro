---
import { THEMES, DEST_ZONES, placeSlug } from '../lib/site.js';
const path = Astro.url.pathname;
const isActive = (href) => path === href || (href !== '/' && path.startsWith(href));
---
<header style="position:sticky;top:0;z-index:100;background:oklch(0.99 0.004 85/0.85);backdrop-filter:blur(12px);border-bottom:1px solid var(--line)">
  <div class="wrap" style="padding-top:15px;padding-bottom:15px;display:flex;align-items:center;gap:26px">
    <a href="/" style="display:flex;align-items:center;gap:10px;flex-shrink:0">
      <div class="frt-disc" style="width:34px;height:34px;font-size:12.5px;letter-spacing:-0.02em">FRT</div>
      <span style="font-family:'Bricolage Grotesque';font-weight:800;font-size:19px;letter-spacing:-0.03em;line-height:1">French Riviera<span style="color:var(--coral)"> Tips</span></span>
    </a>
    <nav class="hide-mobile" style="display:flex;gap:20px;font-size:14px;font-weight:500;color:var(--soft);margin-left:6px;align-items:center">
      <div class="has-mega" style="position:relative">
        <a href="/destinations" style="display:flex;align-items:center;gap:4px;padding:4px 0;color:var(--coral-deep);font-weight:600">Destinations <span style="font-size:10px">▾</span></a>
        <div class="mega">
          {DEST_ZONES.map((zone) => (
            <div>
              <div class="mega-col-h">{zone.label}</div>
              {zone.places.map((p) => (
                <a href={`/destinations/${placeSlug(p)}`}>{p}</a>
              ))}
            </div>
          ))}
          <a href="/destinations" style="display:flex;flex-direction:column;justify-content:flex-end;border-radius:12px;padding:16px;color:#fff;min-height:150px;position:relative;overflow:hidden;background:#0b2b3f url(/images/nice-promenade.png) center/cover no-repeat">
            <div style="position:absolute;inset:0;background:linear-gradient(180deg,oklch(0.24 0.03 255/0.15),oklch(0.24 0.03 255/0.78))"></div>
            <div style="position:relative">
              <div style="font-family:'Bricolage Grotesque';font-weight:700;font-size:15px;line-height:1.2">Browse all destinations</div>
              <div style="font-size:12px;color:#ffffffdd;margin-top:4px">Every town &amp; village →</div>
            </div>
          </a>
        </div>
      </div>
      {THEMES.map((t) => (
        <a href={t.href} style={`padding:4px 0;${isActive(t.href) ? 'color:var(--coral-deep);font-weight:600' : ''}`}>{t.label}</a>
      ))}
    </nav>
    <a href="/destinations" class="hide-mobile" style="margin-left:auto;display:flex;align-items:center;gap:8px;background:var(--card);border:1px solid var(--line);border-radius:999px;padding:9px 16px;font-size:13px;color:var(--faint)">
      <span style="width:13px;height:13px;border:2px solid var(--faint);border-radius:50%;display:inline-block"></span>
      Explore the Riviera
    </a>

    <!-- Mobile hamburger -->
    <button id="navToggle" class="mobile-only" aria-label="Open menu" aria-expanded="false" aria-controls="mobileNav" style="margin-left:auto;width:42px;height:42px;display:none;align-items:center;justify-content:center;background:var(--card);border:1px solid var(--line);border-radius:11px;cursor:pointer;flex-direction:column;gap:4px">
      <span class="nav-bar" style="width:18px;height:2px;background:var(--ink);border-radius:2px;transition:.2s"></span>
      <span class="nav-bar" style="width:18px;height:2px;background:var(--ink);border-radius:2px;transition:.2s"></span>
      <span class="nav-bar" style="width:18px;height:2px;background:var(--ink);border-radius:2px;transition:.2s"></span>
    </button>
  </div>

  <!-- Mobile drawer -->
  <nav id="mobileNav" class="mobile-only" style="display:none;border-top:1px solid var(--line);background:var(--card);max-height:0;overflow:hidden;transition:max-height .28s ease">
    <div class="wrap" style="padding-top:8px;padding-bottom:18px;display:flex;flex-direction:column">
      <a href="/destinations" style="padding:13px 4px;font-size:16px;font-weight:600;color:var(--coral-deep);border-bottom:1px solid var(--line)">Destinations</a>
      {THEMES.map((t) => (
        <a href={t.href} style={`padding:13px 4px;font-size:16px;font-weight:500;border-bottom:1px solid var(--line);${isActive(t.href) ? 'color:var(--coral-deep);font-weight:600' : 'color:var(--ink)'}`}>{t.label}</a>
      ))}
      <a href="/destinations" class="btn-coral" style="margin-top:16px">Explore the Riviera →</a>
    </div>
  </nav>
</header>

<script is:inline>
  (function () {
    var btn = document.getElementById('navToggle');
    var nav = document.getElementById('mobileNav');
    if (!btn || !nav) return;
    var open = false;
    btn.addEventListener('click', function () {
      open = !open;
      btn.setAttribute('aria-expanded', String(open));
      nav.style.maxHeight = open ? nav.scrollHeight + 'px' : '0';
      var bars = btn.querySelectorAll('.nav-bar');
      bars[0].style.transform = open ? 'translateY(6px) rotate(45deg)' : '';
      bars[1].style.opacity = open ? '0' : '1';
      bars[2].style.transform = open ? 'translateY(-6px) rotate(-45deg)' : '';
    });
  })();
</script>
