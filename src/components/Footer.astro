---
import { THEMES } from '../lib/site.js';
import { placeSlug } from '../lib/site.js';
const cities = ['Nice', 'Cannes', 'Monaco', 'Antibes', 'Saint-Tropez'];
---
<footer style="background:var(--deep);color:#fff;margin-top:40px">
  <div class="wrap" style="padding-top:52px;padding-bottom:40px;display:grid;grid-template-columns:1.6fr 1fr 1fr 1fr;gap:32px">
    <div>
      <div style="display:flex;align-items:center;gap:10px">
        <div class="frt-disc" style="width:30px;height:30px;font-size:11px;letter-spacing:-0.02em">FRT</div>
        <span style="font-family:'Bricolage Grotesque';font-weight:800;font-size:18px">French Riviera <span style="color:var(--coral)">Tips</span></span>
      </div>
      <p style="font-size:14px;color:#ffffffaa;margin-top:14px;max-width:280px;text-wrap:pretty">Independent local guides to the Côte d'Azur — destinations, hotels, activities, events and hidden gems.</p>
      <p style="font-size:12px;color:#ffffff77;margin-top:14px;max-width:300px">As an affiliate we earn from qualifying bookings, at no extra cost to you.</p>
    </div>
    <div>
      <div style="font-weight:700;font-size:14px;margin-bottom:12px">Explore</div>
      <div style="display:flex;flex-direction:column;gap:9px;font-size:14px;color:#ffffffaa">
        <a href="/destinations">Destinations</a>
        {THEMES.map((t) => <a href={t.href}>{t.label}</a>)}
      </div>
    </div>
    <div>
      <div style="font-weight:700;font-size:14px;margin-bottom:12px">Destinations</div>
      <div style="display:flex;flex-direction:column;gap:9px;font-size:14px;color:#ffffffaa">
        {cities.map((c) => <a href={`/destinations/${placeSlug(c)}`}>{c}</a>)}
      </div>
    </div>
    <div>
      <div style="font-weight:700;font-size:14px;margin-bottom:12px">About</div>
      <div style="display:flex;flex-direction:column;gap:9px;font-size:14px;color:#ffffffaa">
        <a href="/about">Our story</a>
        <a href="/affiliate-disclosure">Affiliate disclosure</a>
        <a href="/credits">Credits</a>
        <a href="/privacy">Privacy</a>
        <a href="/cookies">Cookies</a>
        <a href="/legal-notices">Legal notices</a>
      </div>
    </div>
  </div>
  <div style="border-top:1px solid #ffffff1f">
    <div class="wrap" style="padding-top:18px;padding-bottom:18px;font-size:12.5px;color:#ffffff77;display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px">
      <span>© {new Date().getFullYear()} French Riviera Tips. All rights reserved.</span>
      <span>Made with love by <a href="https://www.adrigal.website" target="_blank" rel="noopener" style="color:#fff;font-weight:600">Adrigal</a></span>
    </div>
  </div>
</footer>
