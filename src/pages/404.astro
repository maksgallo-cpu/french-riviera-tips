---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="French Riviera Tips | Page not found" noindex={true} description="Page not found.">
  <main class="wrap" style="padding-top:80px;padding-bottom:100px;text-align:center;max-width:560px">
    <div class="frt-disc" style="width:72px;height:72px;font-size:24px;margin:0 auto">FRT</div>
    <h1 style="font-weight:800;font-size:44px;letter-spacing:-0.03em;margin-top:24px">Lost on the coast?</h1>
    <p style="color:var(--soft);font-size:17px;margin-top:10px">We couldn't find that page. It may have moved, or the link may be old.</p>
    <div style="display:flex;gap:12px;justify-content:center;margin-top:28px;flex-wrap:wrap">
      <a href="/" class="btn-coral">Back home</a>
      <a href="/destinations" style="display:inline-block;background:#fff;border:1px solid var(--line);color:var(--ink);font-weight:700;font-size:15px;padding:14px 26px;border-radius:11px">Browse destinations</a>
    </div>
  </main>
</BaseLayout>
