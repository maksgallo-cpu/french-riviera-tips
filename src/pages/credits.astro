---
import BaseLayout from '../layouts/BaseLayout.astro';
const title = "French Riviera Tips | Photo Credits | French Riviera";
const credits = [
  { place: 'Nice — Promenade des Anglais', author: 'Max · French Riviera Tips', href: null, tag: 'Own photo' },
  { place: 'Cannes', author: 'Alexis AMZ DA CRUZ', href: 'https://unsplash.com/@alexisamz' },
  { place: 'Monaco', author: 'Reuben Rohard', href: 'https://unsplash.com/@reubenrohard' },
  { place: 'Èze', author: 'Artem R', href: 'https://unsplash.com/@asci_en' },
  { place: 'Antibes', author: 'Barna Bartis', href: 'https://unsplash.com/@barnabartis' },
  { place: 'Saint-Paul-de-Vence', author: 'Bjorn Agerbeek', href: 'https://unsplash.com/@bjornagerbeek' },
];
---
<BaseLayout title={title} description="Photographers credited for the destination photography used on French Riviera Tips.">
  <main class="wrap" style="padding-top:40px;max-width:820px;padding-bottom:40px">
    <nav style="font-size:13px;color:var(--faint);display:flex;gap:8px"><a href="/">Home</a><span>/</span><span>Credits</span></nav>
    <span class="pill" style="background:var(--coral);color:#fff;margin-top:18px;display:inline-block">CREDITS</span>
    <h1 style="font-weight:800;font-size:38px;letter-spacing:-0.03em;margin-top:12px">Photo credits</h1>
    <p style="color:var(--soft);font-size:15.5px;margin-top:6px;text-wrap:pretty">We're grateful to the photographers whose work brings the Côte d'Azur to life on this site. Destination photography is sourced from Unsplash under the Unsplash License; you can find each photographer below.</p>
    <div style="margin-top:26px;border:1px solid var(--line);border-radius:16px;background:var(--card);overflow:hidden">
      {credits.map((c, i) => {
        const inner = (
          <div style={`display:flex;align-items:center;justify-content:space-between;gap:16px;padding:16px 20px;${i < credits.length - 1 ? 'border-bottom:1px solid var(--line)' : ''}`}>
            <div>
              <div style="font-family:'Bricolage Grotesque';font-weight:700;font-size:16px">{c.place}</div>
              <div style="font-size:13px;color:var(--faint);margin-top:1px">Photograph by {c.author}</div>
            </div>
            <span style={`font-size:12px;font-weight:600;white-space:nowrap;color:${c.href ? 'var(--coral-deep)' : 'var(--faint)'}`}>{c.href ? 'Unsplash ↗' : c.tag}</span>
          </div>
        );
        return c.href ? <a href={c.href} target="_blank" rel="noopener">{inner}</a> : inner;
      })}
    </div>
  </main>
</BaseLayout>
